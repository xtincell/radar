# Postgres — obligatoire pour activer le backend (mini-PostgREST maison, server/pgrest.js).
# Sans cette variable, le serveur démarre quand même mais sert les assets statiques uniquement.
DATABASE_URL=postgres://user:password@host:5432/radar

# Nom affiché (titres, feeds RSS/JSON, realm HTTP Basic Auth, logs). Défaut : "Radar".
RADAR_NAME=Radar

# Port d'écoute HTTP. Défaut : 3000.
PORT=3000

# Mois courant de l'équipe pour le périmètre membre. Aligner les postes de l'équipe.
TZ=Africa/Douala

# ---- Autorité (qui peut se connecter, avec quel niveau) --------------------
# Un seul email admin (role "owner"), pas de roster externe. Suffisant pour un
# usage solo ou une instance de test.
RADAR_ADMIN_EMAIL=admin@example.com

# Chemin d'un fichier JSON décrivant le roster complet (email -> {person, role}).
# Prioritaire sur RADAR_ADMIN_EMAIL si défini. Format :
#   { "alice@example.com": { "person": "Alice", "role": "owner" },
#     "bob@example.com":   { "person": "Bob",   "role": "member" } }
# Rôles : owner (accès total + /rh), supervisor (toutes les tâches), member (ses tâches).
#RADAR_AUTHZ_JSON=/path/to/authz.json

# Mot de passe partagé pour activer le mur d'authentification (HTTP Basic Auth).
# Sans cette variable, le mur ne bloque personne.
#DASH_PASSWORD=change-me

# Emails autorisés en plus de ceux du roster (CSV, optionnel).
#DASH_ALLOWLIST=extra1@example.com,extra2@example.com

# Clé de signature du cookie de session. Optionnel : à défaut, signé avec DASH_PASSWORD.
#DASH_COOKIE_SECRET=

# Fichier SQLite des mots de passe personnels (/profil), stockés sous empreinte
# PBKDF2-SHA256. Défaut ./dash-users.sqlite3 ; l'image Docker utilise le volume.
# Conversion des anciennes valeurs en clair : node server/hash-passwords.js
#SQLITE_PATH=/data/dash-users.sqlite3

# CSV optionnel (colonnes INDEX.csv) pour peupler une base vide au premier boot.
# Absent → instance vierge, aucune dépendance à un dossier local.
#RADAR_SEED_CSV=/path/to/INDEX.csv

# Clé porteuse full-access pour les intégrations machine (API/MCP) : franchit le
# mur ET lève le scope private_to. Ne jamais commiter une vraie valeur.
#RADAR_API_KEY=

# ---- Ce qui est public (functions/_publication.js) -------------------------
# Rien n'est publié sans connexion par défaut (arbitrage 5.7). Sans choix ci-
# dessous, /feed.xml, /activity.json, /jour.html et /jour.json sont derrière le
# mur ; le flux y est un aperçu réservé à owner/supervisor et à RADAR_API_KEY.
# Publie /feed.xml et /activity.json aux seuls détenteurs du jeton (?token=...).
# Prime sur FEED_PUBLIC. Ne jamais commiter une vraie valeur.
#FEED_TOKEN=
# Publie /feed.xml et /activity.json sans jeton (1, true, oui, yes ou on).
#FEED_PUBLIC=1
# Publie /jour.html et /jour.json sans connexion (1, true, oui, yes ou on).
#JOUR_PUBLIC=1

# Secret de signature des JWT émis par /token (intégration Supabase RLS). Optionnel.
#SUPABASE_JWT_SECRET=

# ---- Visuels de livrables (POST /visuels, images servies sur /visuels/…) ----
# Répertoire de stockage des binaires. Défaut : /data/visuels (volume Docker),
# repli ./data/visuels hors Docker. Les métadonnées vivent en base (brief_assets).
#VISUELS_DIR=/data/visuels
# Plafond global de stockage des visuels, en Mo (défaut 512). Quota atteint → 413.
#VISUELS_QUOTA_MB=512

# ---- Ingest des retours clients (POST /ingest, LLM local via Ollama) --------
# Le retour client (texte libre) est transformé en tâches structurées, insérées
# en statut « Reçu » (brief déduit) → revue humaine via la page « À valider ».
# Ollama injoignable → repli : une entrée brute « Retour client à trier ».
#OLLAMA_URL=http://127.0.0.1:11434
#OLLAMA_MODEL=llama3.2

# ---- Décisions La Barre (server/barre.js, SHK-0005 sens 1) -----------------
# Radar lit GET <BARRE_URL>/radar/decisions à intervalle. Sans BARRE_URL ou sans
# jeton d'au moins 32 caractères, le lecteur reste désactivé. Le jeton est celui
# posé côté La Barre (même nom de variable) ; ne jamais commiter une vraie valeur.
#BARRE_URL=http://la-barre:3000
#BARRE_RADAR_TOKEN=
# Nom stable de l'installation La Barre dans les reçus (défaut : hôte de BARRE_URL).
#BARRE_INSTANCE=la-barre-entreprise
# Minutes entre deux lectures (défaut 15, plancher 1 s ; 0 désactive).
#BARRE_INTERVAL_MIN=15
# Nom de cette instance Radar dans les correspondances projet ↔ dossier
# (défaut : RADAR_NAME, sinon "Radar").
#RADAR_INSTANCE=
